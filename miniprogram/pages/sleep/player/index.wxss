.player-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.cover-wrap {
  position: relative;
  overflow: hidden;
  width: 560rpx;
  max-width: 100%;
  aspect-ratio: 1;
  border-radius: 52rpx;
  background: linear-gradient(145deg, #71d1d0, #174d5a);
  box-shadow: 0 30rpx 80rpx rgba(17, 84, 94, 0.24);
}

.cover,
.cover-shade {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.cover-shade {
  background: linear-gradient(180deg, rgba(9, 55, 64, 0.04), rgba(9, 55, 64, 0.42));
}

.cover-label {
  position: absolute;
  right: 0;
  bottom: 34rpx;
  left: 0;
  color: rgba(255, 255, 255, 0.88);
  font-size: 20rpx;
  font-weight: 650;
  letter-spacing: 6rpx;
  text-align: center;
}

.sound-title {
  margin-top: 42rpx;
  color: #173f47;
  font-size: 42rpx;
  font-weight: 700;
}

.sound-hint {
  margin-top: 10rpx;
  color: #718c90;
  font-size: 25rpx;
}

.play-button {
  width: 220rpx;
  height: 92rpx;
  margin-top: 30rpx;
  border-radius: 48rpx;
  background: #087f8c;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 650;
  line-height: 92rpx;
  box-shadow: 0 14rpx 30rpx rgba(8, 127, 140, 0.24);
}

.play-button::after,
.cancel-timer::after {
  border: 0;
}

.timer-card {
  width: 100%;
  margin-top: 52rpx;
  padding: 32rpx;
  box-sizing: border-box;
}

.timer-title {
  color: #214f56;
  font-size: 31rpx;
  font-weight: 650;
}

.timer-hint {
  margin-top: 8rpx;
  color: #789094;
  font-size: 24rpx;
}

.time-picker {
  margin-top: 26rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #eaf7f7;
  color: #087f8c;
  font-size: 28rpx;
  font-weight: 650;
  text-align: center;
}

.countdown-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid #e2eeee;
}

.countdown-label {
  color: #789094;
  font-size: 22rpx;
}

.countdown-value {
  margin-top: 5rpx;
  color: #214f56;
  font-size: 34rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.cancel-timer {
  margin: 0;
  padding: 16rpx 28rpx;
  border-radius: 34rpx;
  background: #fff0ee;
  color: #b64a3d;
  font-size: 24rpx;
  line-height: 1.2;
}
