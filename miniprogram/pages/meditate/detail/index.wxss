.detail-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #dff4f3 0%, #f4fbfb 58%);
}

.detail-visual {
  position: relative;
  display: flex;
  height: 550rpx;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.visual-orbit {
  position: absolute;
  border: 2rpx solid rgba(8, 127, 140, 0.12);
  border-radius: 50%;
}

.orbit-one {
  width: 430rpx;
  height: 430rpx;
}

.orbit-two {
  width: 600rpx;
  height: 600rpx;
}

.visual-core {
  position: relative;
  z-index: 2;
  display: flex;
  width: 310rpx;
  height: 310rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(145deg, #69c9c8, #107885);
  box-shadow: 0 30rpx 70rpx rgba(8, 127, 140, 0.22);
  color: #ffffff;
}

.visual-label {
  font-size: 21rpx;
  font-weight: 650;
  letter-spacing: 5rpx;
}

.visual-time {
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.detail-content {
  padding: 10rpx 32rpx 60rpx;
}

.detail-title {
  color: #174951;
  font-size: 52rpx;
  font-weight: 700;
}

.detail-description {
  margin-top: 16rpx;
  color: #658187;
  font-size: 28rpx;
  line-height: 1.7;
}

.detail-note {
  margin-top: 34rpx;
  padding: 28rpx;
  color: #5e7c81;
  font-size: 25rpx;
  line-height: 1.7;
}

.start-button {
  width: 100%;
  margin-top: 34rpx;
}
