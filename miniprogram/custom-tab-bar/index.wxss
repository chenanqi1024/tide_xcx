.tab-bar {
  position: fixed;
  z-index: 100;
  right: 0;
  bottom: 0;
  left: 0;
  border-top: 1rpx solid rgba(8, 127, 140, 0.09);
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -12rpx 36rpx rgba(20, 92, 101, 0.08);
}

.tab-bar-inner {
  display: grid;
  height: 116rpx;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  align-items: center;
}

.tab-item {
  display: flex;
  min-width: 0;
  height: 100%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #78909c;
}

.tab-icon {
  width: 50rpx;
  height: 50rpx;
}

.tab-label {
  margin-top: 5rpx;
  font-size: 28rpx;
  font-weight: 650;
  line-height: 1.15;
}

.tab-item-active {
  color: #087f8c;
}

.safe-area {
  height: env(safe-area-inset-bottom);
  background: #ffffff;
}
