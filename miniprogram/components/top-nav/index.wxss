.top-nav {
  position: sticky;
  z-index: 20;
  top: 0;
  background: rgba(244, 251, 251, 0.96);
}

.top-nav-content {
  display: flex;
  height: 96rpx;
  align-items: center;
  padding: 0 32rpx;
  border-bottom: 1rpx solid rgba(8, 127, 140, 0.08);
  box-sizing: border-box;
}

.top-nav-icon {
  width: 46rpx;
  height: 46rpx;
  margin-right: 16rpx;
}

.top-nav-title {
  color: #153f46;
  font-size: 40rpx;
  font-weight: 750;
  letter-spacing: 2rpx;
}
