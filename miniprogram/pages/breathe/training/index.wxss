.training-page {
  min-height: 100vh;
  padding: 50rpx 32rpx 60rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #e7f8f7 0%, #f4fbfb 70%);
}

.training-header {
  text-align: center;
}

.training-rhythm {
  color: #087f8c;
  font-size: 23rpx;
  font-weight: 650;
  letter-spacing: 5rpx;
}

.training-title {
  margin-top: 12rpx;
  color: #174951;
  font-size: 40rpx;
  font-weight: 700;
}

.training-elapsed {
  margin-top: 12rpx;
  color: #708c90;
  font-size: 24rpx;
  font-variant-numeric: tabular-nums;
}

.breath-stage {
  position: relative;
  display: flex;
  height: 700rpx;
  align-items: center;
  justify-content: center;
}

.breath-ball {
  position: relative;
  z-index: 2;
  display: flex;
  width: 390rpx;
  height: 390rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(145deg, #59c6c5, #0b7f8c);
  box-shadow: 0 30rpx 80rpx rgba(8, 127, 140, 0.26), inset 0 2rpx 4rpx rgba(255, 255, 255, 0.36);
  color: #ffffff;
  transition-property: transform;
  transition-timing-function: ease-in-out;
}

.phase-label {
  font-size: 30rpx;
  font-weight: 650;
  letter-spacing: 6rpx;
}

.phase-time {
  margin-top: 8rpx;
  font-size: 100rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.breath-ring {
  position: absolute;
  border: 2rpx solid rgba(8, 127, 140, 0.1);
  border-radius: 50%;
}

.breath-ring-one {
  width: 500rpx;
  height: 500rpx;
}

.breath-ring-two {
  width: 620rpx;
  height: 620rpx;
}

.training-copy {
  color: #658187;
  font-size: 25rpx;
  line-height: 1.6;
  text-align: center;
}

.training-controls {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 34rpx;
}

.training-controls button {
  width: 100%;
  margin: 0;
}
