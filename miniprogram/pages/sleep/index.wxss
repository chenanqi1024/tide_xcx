.sound-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24rpx;
}

.sound-card {
  position: relative;
  overflow: hidden;
  width: 100%;
  aspect-ratio: 1;
  border-radius: 32rpx;
  background: linear-gradient(145deg, #66c4c5, #175c68);
  box-shadow: 0 14rpx 34rpx rgba(23, 92, 104, 0.18);
}

.sound-cover,
.sound-overlay {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.sound-overlay {
  background: linear-gradient(180deg, rgba(5, 36, 43, 0.06), rgba(5, 36, 43, 0.64));
}

.sound-name {
  position: absolute;
  top: 50%;
  right: 20rpx;
  left: 20rpx;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.35;
  text-align: center;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.26);
  transform: translateY(-50%);
}

.sound-play {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  padding: 9rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.36);
  border-radius: 30rpx;
  background: rgba(6, 50, 58, 0.32);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 600;
  backdrop-filter: blur(12rpx);
}
